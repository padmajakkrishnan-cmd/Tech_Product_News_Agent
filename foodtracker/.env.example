# === Food & Habit Tracker configuration ===

# Required: get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude model used for parsing text and meal photos
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: where to store the SQLite database
FOODTRACKER_DB=foodtracker.db

# Optional: web server bind settings
HOST=0.0.0.0
PORT=8000

# Optional: default goals (also editable in-app on the Goals page)
GOAL_WAKE_TIME=06:30
GOAL_CALORIES=2000
GOAL_PROTEIN=120
GOAL_WORKOUTS=4
GOAL_WATER=8
GOAL_SLEEP=7.5
